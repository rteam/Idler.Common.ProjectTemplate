<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\BaseMicroService.Domain\BaseMicroService.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Idler.Common.Autofac" Version="0.2.0.1" />
        <PackageReference Include="Idler.Common.EntityFrameworkCore" Version="0.2.0.1" />
    </ItemGroup>
    <ItemGroup Condition="'$(PostgreSQL)' == 'True' ">
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.1" />
    </ItemGroup>
    <ItemGroup Condition="'$(MySQL)' == 'True' ">
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    

</Project>
